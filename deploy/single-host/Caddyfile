# Automatic mode uses Caddy's built-in certificate management, so its dynamic
# import intentionally has no additional directives.
(tls-automatic) {
}

(tls-provided) {
	tls {
		load /etc/caddy/certificates/current
	}
}

https://{$PEGELHUB_FRONTEND_HOSTNAME}{$PEGELHUB_HTTPS_URL_SUFFIX} {
	import tls-{$PEGELHUB_TLS_MODE}
	encode zstd gzip
	reverse_proxy frontend:80
	handle_errors {
		respond "PegelHub frontend is not deployed in this stack yet." 503
	}
}

https://{$PEGELHUB_API_HOSTNAME}{$PEGELHUB_HTTPS_URL_SUFFIX} {
	import tls-{$PEGELHUB_TLS_MODE}
	encode zstd gzip
	reverse_proxy core-app:8080
}

https://{$PEGELHUB_KEYCLOAK_HOSTNAME}{$PEGELHUB_HTTPS_URL_SUFFIX} {
	import tls-{$PEGELHUB_TLS_MODE}
	encode zstd gzip
	reverse_proxy keycloak:8080
}
