# Copy this file to the deployment's configuration directory as pegelhub.env.
# Do not commit the installed file or real deployment secrets.

# -------------------------------------------------------------------
# Deployment
# -------------------------------------------------------------------
COMPOSE_PROJECT_NAME=pegelhub
# Public bindings. Keep the defaults for production. A side-by-side rehearsal
# can use loopback-only alternatives such as 127.0.0.1:18080 and
# 127.0.0.1:18443 without exposing the new platform publicly.
PEGELHUB_HTTP_BIND=80
PEGELHUB_HTTPS_BIND=443
# Leave empty on the public 443 binding. Set to the rehearsal port (for
# example :18443) so Keycloak issuer and frontend login URLs remain isolated.
PEGELHUB_HTTPS_URL_SUFFIX=
# Must match the externally published HTTPS port so Core can reach the same
# issuer through Caddy's internal network alias.
PEGELHUB_HTTPS_CONTAINER_PORT=443
PEGELHUB_TLS_MODE=automatic
PEGELHUB_TRUST_MODE=system
# By default these directories live below PEGELHUB_CONFIG_DIR.
# PEGELHUB_TLS_SERVER_DIR=/absolute/path/to/tls/server
# PEGELHUB_TRUST_DIR=/absolute/path/to/tls/trust

# -------------------------------------------------------------------
# Backend image version
# Usually changed by backend deployment automation.
# -------------------------------------------------------------------
# Examples: v0.1.0, sha-42bd19b
PEGELHUB_IMAGE_TAG=sha-replace-me

# -------------------------------------------------------------------
# Public hostnames
# Set once after DNS is known.
# -------------------------------------------------------------------
PEGELHUB_FRONTEND_HOSTNAME=pegelhub.example.com
PEGELHUB_API_HOSTNAME=api.pegelhub.example.com
PEGELHUB_KEYCLOAK_HOSTNAME=auth.pegelhub.example.com
# The explicit Keycloak bootstrap derives the browser redirect and web origin
# from https://${PEGELHUB_FRONTEND_HOSTNAME}. Deployment scripts reject these
# example values until all three hostnames are replaced with real DNS names.

# -------------------------------------------------------------------
# Metadata database
# META_PASSWORD is generated once on the deployment host.
# -------------------------------------------------------------------
META_DB=pegelhub
META_PASSWORD=replace-with-pegelhub-meta-password

# -------------------------------------------------------------------
# InfluxDB
# Password/token values are generated once on the deployment host.
# -------------------------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=replace-with-pegelhub-influx-admin-password
INFLUX_ORG=pegelhub
INFLUX_INTERNAL_BUCKET=pegelhub-internal
INFLUX_DATA_BUCKET=pegelhub-data
# Use 0s to retain measurements indefinitely.
INFLUX_DATA_RETENTION=60d
INFLUX_TELEMETRY_BUCKET=pegelhub-telemetry
# Use 0s to retain telemetry indefinitely.
INFLUX_TELEMETRY_RETENTION=60d
INFLUX_LATEST_RANGE=72h
INFLUX_TOKEN=replace-with-pegelhub-influx-token

# -------------------------------------------------------------------
# Keycloak
# Password values are generated once on the deployment host.
# -------------------------------------------------------------------
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-pegelhub-keycloak-db-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-pegelhub-keycloak-admin-password

# -------------------------------------------------------------------
# Runtime tuning
# -------------------------------------------------------------------
CORE_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
