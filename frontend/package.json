{
  "name": "pegelhub-frontend-next",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --proxy-config proxy.conf.cjs",
    "start:4201": "ng serve --host localhost --port 4201 --proxy-config proxy.conf.cjs",
    "start:no-proxy": "ng serve --host localhost",
    "build": "ng build",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "image:validate": "scripts/validate-production-image.sh",
    "check": "prettier --check . && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && ng test --watch=false",
    "smoke:live": "node scripts/live-stack-smoke.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@ag-grid-community/locale": "^36.0.2",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@primeuix/themes": "^2.0.3",
    "ag-grid-angular": "^36.0.2",
    "ag-grid-community": "^36.0.2",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "keycloak-angular": "^21.0.0",
    "keycloak-js": "^26.2.4",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.1",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
